{
  "name": "resumeforge",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "resumeforge": "bin/resumeforge.js"
  },
  "scripts": {
    "dev": "next dev",
    "dev:tailscale": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start",
    "start:tailscale": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "test:unit": "node --import tsx --test src/lib/*.test.ts src/lib/applications/*.test.ts src/lib/utils/*.test.ts src/lib/insights/*.test.ts src/lib/claude/skills/*.test.ts extension/*.test.js bin/*.test.js",
    "backfill:classifications": "tsx scripts/backfill-job-classifications.ts",
    "taxonomy:review": "tsx scripts/taxonomy-review.ts",
    "benchmark:resumes": "node --import tsx scripts/run-resume-benchmarks.ts",
    "worker": "npx tsx src/worker.ts",
    "dev:all": "npx concurrently --kill-others-on-fail --names next,worker --prefix-colors blue,green \"npm run dev\" \"npm run worker\""
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dagrejs/dagre": "^3.0.0",
    "@prisma/client": "^6.19.2",
    "@react-pdf/renderer": "^4.3.2",
    "@types/prismjs": "^1.26.6",
    "@xyflow/react": "^12.10.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.19.2",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
