generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  email     String?
  additionalEmails String? // JSON array of extra email addresses
  phone     String?
  location  String?
  summary   String?
  linkedin       String?
  github         String?
  website        String?
  twitter        String?
  pinterest      String?
  stackoverflowId  String?
  recommendations  String?  // JSON array of {recommenderName, recommenderTitle, relationship, text, linkedinUrl?}
  lastEnrichedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  experiences Experience[]
  educations  Education[]
  projects    Project[]
  skills      Skill[]
  publications    Publication[]
  certifications  Certification[]
  resumes              Resume[]
  profileVersions      ProfileVersion[]
  applicationProfile   ApplicationProfile?
  guides               Guide[]
  learningPaths        LearningPath[]
  savedSources         SavedSource[]

  // Learn recommendations cache
  cachedGaps              String?
  cachedGapsAt            DateTime?
  gapsCacheFingerprint    String?
  cachedRecommendations   String?
  cachedRecommendationsAt DateTime?
  recsCacheFingerprint    String?

  // Insights cache
  cachedInsights           String?
  cachedInsightsAt         DateTime?
  insightsCacheFingerprint String?
}

model Experience {
  id        String   @id @default(cuid())
  profileId String
  company   String
  title     String
  startDate String
  endDate   String?
  current   Boolean  @default(false)
  bullets   String   // JSON array of strings
  skills    String?  // JSON array of skill names

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id        String  @id @default(cuid())
  profileId String
  school    String
  degree    String
  field     String?
  startDate String?
  endDate   String?
  gpa       String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          String  @id @default(cuid())
  profileId   String
  name        String
  description String?
  url         String?
  skills      String? // JSON array of skill names

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String @id @default(cuid())
  profileId String
  name      String
  category  String // language, framework, tool, database, cloud, soft

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Publication {
  id          String  @id @default(cuid())
  profileId   String
  title       String
  publisher   String?
  date        String?
  url         String?
  doi         String?
  description String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certification {
  id           String  @id @default(cuid())
  profileId    String
  name         String
  issuer       String?
  date         String?
  expiryDate   String?
  credentialId String?
  url          String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Job {
  id           String   @id @default(cuid())
  title        String
  company      String
  url          String?
  description  String
  skills       String?  // JSON array of required skill names
  requirements String?  // JSON array of {requirement, classification, confidence, bridgeNote}
  atsKeywords  String?  // JSON object of {technical, domain, tools, softSkills}
  seniority    String?  // junior|mid|senior|staff|principal
  sponsorship     String?  // available|unavailable|unspecified — visa/work authorization status
  terminologyMap  String?  // JSON array of {jdTerm, resumeSynonyms[]}
  matchResult     String?  // JSON — cached profile match analysis
  matchedAt    DateTime? // when match was last computed (stale if profile.updatedAt > this)
  aiModel      String   @default("sonnet") // AI model for this job's pipeline (sonnet|haiku|opus)
  source       String?   // e.g., "email-glassdoor", "email-linkedin", "email-indeed", "manual"
  canonicalUrl String?   // resolved employer ATS URL (from two-hop scraping)
  applied      Boolean  @default(false)
  appliedAt    DateTime?
  coverLetter    String?  // JSON — cached generated cover letter (CoverLetterData)
  interviewPrep  String?  // JSON — cached STAR+R interview prep (InterviewPrep)
  createdAt      DateTime @default(now())

  resumes              Resume[]
  profileVersions      ProfileVersion[]
  chatSessions         ChatSession[]
  applicationAnswers   ApplicationAnswer[]
}

model ProfileVersion {
  id        String   @id @default(cuid())
  profileId String
  jobId     String
  snapshot  String   // JSON — full profile data at time of save
  score     Float    // ATS match score when saved
  delta     Float?   // score improvement over original
  label     String?  // optional user label e.g. "Optimized for Google SWE"
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumes Resume[]
}

model ChatSession {
  id        String   @id @default(cuid())
  type      String   // profile | job | skills
  jobId     String?
  title     String?
  messages  String   // JSON array of {role, content, ...metadata}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Resume {
  id               String   @id @default(cuid())
  profileId        String
  jobId            String
  profileVersionId String?
  format           String   // pdf, docx, latex
  filePath         String
  createdAt        DateTime @default(now())

  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileVersion ProfileVersion? @relation(fields: [profileVersionId], references: [id])
}

model TokenUsage {
  id                       String   @id @default(cuid())
  skill                    String
  model                    String
  inputTokens              Int
  outputTokens             Int
  cacheReadInputTokens     Int      @default(0)
  cacheCreationInputTokens Int      @default(0)
  costUsd                  Float
  durationMs               Int
  createdAt                DateTime @default(now())
}

model ApplicationProfile {
  id                String   @id @default(cuid())
  profileId         String   @unique
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Name split (computed from Profile.name, editable)
  firstName         String?
  lastName          String?

  // Work authorization
  workAuthorized    Boolean?
  sponsorshipNeeded Boolean?

  // Preferences
  salaryMin         Int?
  salaryMax         Int?
  willingToRelocate String?  // "yes" | "no" | "depends"
  noticePeriod      String?  // "immediately" | "2 weeks" | "1 month" | etc.
  preferredWorkMode String?  // "remote" | "hybrid" | "onsite" | "any"
  earliestStartDate String?  // ISO date or "immediately"

  // EEO (voluntary, never sent to AI)
  gender            String?  // "male" | "female" | "non_binary" | "prefer_not_to_say"
  race              String?  // EEOC category or "prefer_not_to_say"
  veteranStatus     String?  // "yes" | "no" | "prefer_not_to_say"
  disabilityStatus  String?  // "yes" | "no" | "prefer_not_to_say"

  // Defaults
  heardAboutDefault String?
  over18            Boolean  @default(true)
  customDefaults    String?  // JSON array of {question, answer} — pinned reusable answers

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ApplicationAnswer {
  id        String   @id @default(cuid())
  jobId     String
  question  String
  answer    String
  source    String   @default("auto") // "auto" | "ai" | "manual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, question])
}

model LearnedAnswer {
  id          String   @id @default(cuid())
  normalizedQ String
  originalQ   String
  fieldType   String   @default("text")
  answer      String
  options     String?
  confidence  Int      @default(50)
  source      String   @default("observed")
  useCount    Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([normalizedQ, answer])
  @@index([normalizedQ])
}

model LearningPath {
  id          String   @id @default(cuid())
  title       String
  description String?
  guideOrder  String   @default("[]")
  category    String?
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  guides      Guide[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Guide {
  id               String         @id @default(cuid())
  topic            String
  slug             String         @unique
  content          String
  version          Int            @default(1)
  status           String         @default("draft")
  category         String?
  tags             String         @default("[]")
  completionStatus String         @default("not_started")
  sectionProgress  String         @default("{}")
  profileId        String
  profile          Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  learningPathId   String?
  learningPath     LearningPath?  @relation(fields: [learningPathId], references: [id])
  sources          GuideSource[]
  versions         GuideVersion[]
  lastAsyncError   String?
  lastAsyncStage   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model GuideVersion {
  id                String   @id @default(cuid())
  guideId           String
  guide             Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  version           Int
  content           String
  changeDescription String?
  createdAt         DateTime @default(now())
}

model GuideSource {
  id        String   @id @default(cuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  type      String
  url       String?
  title     String?
  content   String
  createdAt DateTime @default(now())
}

model SavedSource {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String   // "medium" | "substack" | "article"
  url       String
  title     String
  content   String
  captureMethod   String?
  publisher       String?
  publishedAt     String?
  lastRefreshedAt DateTime?
  createdAt DateTime @default(now())
}
