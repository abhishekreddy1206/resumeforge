DATABASE_URL="file:./prisma/dev.db"

# Optional: GitHub personal access token for higher API rate limits
# GITHUB_TOKEN=""

# Gmail API — for scanning job alert emails (Scan Emails button on jobs page)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API, then run a one-time OAuth flow with scope:
#   https://www.googleapis.com/auth/gmail.readonly
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""

# Substack — cookie for fetching paid subscriber content
# Get from browser DevTools > Application > Cookies > connect.sid on substack.com
SUBSTACK_CONNECT_SID=

# Medium — cookies for fetching member content
# Get from browser DevTools > Application > Cookies on medium.com
MEDIUM_SID=
MEDIUM_UID=
